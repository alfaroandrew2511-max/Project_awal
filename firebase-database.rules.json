{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 400 && newData.child('createdAt').isNumber()",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'createdAt'])",
            "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 400" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'lastSeen'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "reports": {
          "$reportId": {
            ".write": "auth != null && !data.exists() && newData.child('reporterUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['reporterUid', 'messageId', 'reason', 'createdAt'])",
            "reporterUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "messageId": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "reason": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}